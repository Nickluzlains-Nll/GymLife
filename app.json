{
  "expo": {
    "name": "GymLife",
    "slug": "GymLife",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymlife.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.gymlife.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "O GymLife precisa acessar suas fotos para você escolher a foto de perfil."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "63156e96-d555-42c2-b652-eabcc26d593b"
      }
    },
    "owner": "nicolasluzlains"
  }
}
